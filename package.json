{
  "name": "meristem-chat-control-spike",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:extension",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:extension",
    "test:control": "node --test --test-concurrency=2 dist/test/*.test.js",
    "verify": "npm run build:native && npm run typecheck && npm run build && npm test && npm run test:control && npm run test:terminal",
    "build:native": "powershell.exe -NoProfile -File scripts/build-native.ps1 -OutputDirectory .local/chat-control-build -WithFixtures",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "build:extension": "tsc -p extension/tsconfig.json",
    "package:extension": "npm run build:extension && powershell.exe -NoProfile -File scripts/package-extension.ps1",
    "package:release": "powershell.exe -NoProfile -File scripts/package-release.ps1",
    "test:terminal": "node --test extension/dist/test/terminal.test.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.9.3"
  }
}
