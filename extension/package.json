{
  "name": "meristem-chat-control-fixture",
  "displayName": "Meristem Chat Control",
  "description": "Worker terminal display, stop controls and human approval for a bound local run.",
  "publisher": "meristem-local",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "main": "./dist/src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": { "menus": { "explorer/context": [
    { "command": "meristem.chatControl.newTerminalRun", "when": "resourceScheme == file && resourceExtname == .md && isWorkspaceTrusted" }
  ] }, "commands": [
    { "command": "meristem.chatControl.startRun", "title": "Meristem: 既存の Codex 会話で開始" },
    { "command": "meristem.chatControl.newTerminalRun", "title": "Meristem: このウィンドウで新しい Codex 親チャットを開く" },
    { "command": "meristem.chatControl.usage", "title": "Meristem: Codex の使用状況を確認" },
    { "command": "meristem.chatControl.progress", "title": "Meristem: 進捗と承認要求を確認" },
    { "command": "meristem.chatControl.openManaged", "title": "Meristem: Open Managed Worker Terminals" }, { "command": "meristem.chatControl.showWorkerDetails", "title": "Meristem: Show Current Worker Details" }, { "command": "meristem.chatControl.listWorkers", "title": "Meristem: List Worker Terminals" }, { "command": "meristem.chatControl.listPendingDecisions", "title": "Meristem: 回答待ちの相談を読む" }, { "command": "meristem.chatControl.viewWorkerHistory", "title": "Meristem: ワーカーの Codex 履歴を読む" }, { "command": "meristem.chatControl.prepareWorkerHistoryResume", "title": "Meristem: 履歴を照合して再開を準備" }, { "command": "meristem.chatControl.renameWorker", "title": "Meristem: Rename Current Worker" }, { "command": "meristem.chatControl.retireWorker", "title": "Meristem: Retire Current Worker (Keep Run Active)" }, { "command": "meristem.chatControl.stopRun", "title": "Meristem: 実行を停止" }, { "command": "meristem.chatControl.reviewRequest", "title": "Meristem: Review Worker MCP Request" }, { "command": "meristem.chatControl.openFixture", "title": "Meristem: Open Fixture Worker Terminal" }, { "command": "meristem.chatControl.stopFixture", "title": "Meristem: Stop Current Worker" }] }
}
